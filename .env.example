# Postgres (Neon / Supabase connection string, use pooled connection for serverless)
DATABASE_URL="postgresql://user:password@host:5432/nacoss_evoting?pgbouncer=true"



# Brevo API Mailer Settings
BREVO_API_KEY="your-brevo-api-key"
BREVO_SENDER_EMAIL="elections@yourdomain.com"
BREVO_SENDER_NAME="NACOSS Elections"

# Secrets — generate with `openssl rand -hex 32`, never commit real values
OTP_SECRET=""
ADMIN_JWT_SECRET=""
VOTER_JWT_SECRET=""
ELECTION_SALT=""

# File storage — Cloudflare R2 (S3-compatible) or any S3-compatible provider
STORAGE_ENDPOINT="https://<account_id>.r2.cloudflarestorage.com"
STORAGE_BUCKET_NAME="nacoss-evoting-id-cards"
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""

# Admin bootstrap (used only by `npm run prisma:seed`, not read at runtime)
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""

# Upstash Redis — for globally-consistent rate limiting across serverless instances
# Create a free database at https://console.upstash.com, then paste the REST URL & token.
# If not set, the app falls back to an in-process memory store (fine for local dev).
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
